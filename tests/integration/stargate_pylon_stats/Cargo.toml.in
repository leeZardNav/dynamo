[package]
name = "stargate-pylon-stats-e2e"
version = "0.0.0"
edition = "2024"
publish = false

[workspace]

[[bin]]
name = "stargate-pylon-stats-e2e"
path = "@HARNESS_SOURCE@"

[dependencies]
anyhow = "1"
async-stream = "0.3"
dynamo-llm = { path = "@DYNAMO_ROOT@/lib/llm", default-features = false }
dynamo-runtime = { path = "@DYNAMO_ROOT@/lib/runtime" }
futures = "0.3"
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls", "stream"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
socket2 = "0.6"
tokio = { version = "1", features = ["fs", "io-util", "macros", "net", "process", "rt-multi-thread", "signal", "sync", "time"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
